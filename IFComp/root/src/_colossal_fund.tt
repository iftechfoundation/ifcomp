<h2 id="colossal-fund">The Colossal Fund</h2>
<div style="position:relative;overflow:hidden;width:100%;padding-top:120px;"><iframe title='Donation form powered by Zeffy' style='position: absolute; border: 0; top:0;left:0;bottom:0;right:0;width:100%;height:120px' src='https://www.zeffy.com/embed/thermometer/ifcomp-colossal-fund--2026'  allowTransparency="true"></iframe></div>
<p>
Support IFComp and its authors through a charitable gift to <strong>The
Colossal Fund</strong>, providing a cash prize pool for top IFComp entries! <a
href="http://blog.ifcomp.org/post/162478013529/announcing-the-ifcomp-colossal-fund">Learn
more about it</a>, and <a href="/about/colossal/">see who [% IF cf.goal %]has[%
END %] contributed [% IF cf.goal %]this[% ELSE %]last[% END %] year</a>.
</p>

[% USE Number.Format %]
[% USE Math %]

[% IF cf.goal %]
    <div>
        <div data-zeffy-embed data-form-url="/embed/donation-form/ifcomp-colossal-fund--2026"></div>
        <div data-zeffy-embed-fallback style="display:none;">
            <div style="position:relative;overflow:hidden;height:450px;width:100%;"><iframe title='Donation form powered by Zeffy' style='position: absolute; border: 0; top:0;left:0;bottom:0;right:0;width:100%;height:100%' data-zeffy-embed-src='https://www.zeffy.com/embed/donation-form/ifcomp-colossal-fund--2026' allowpaymentrequest allowTransparency="true"></iframe></div>
        </div>
        <script
           src="https://www.zeffy.com/embed/v2/zeffy-embed.js"
           onerror="document.querySelectorAll('[data-zeffy-embed-fallback]').forEach(function(el){el.style.display='block';el.querySelectorAll('iframe[data-zeffy-embed-src]').forEach(function(f){f.src=f.getAttribute('data-zeffy-embed-src');});});">
        </script>
    </div>

[% ELSE %]

    <p>
    This year's Colossal Fund drive will kick off in mid-July. Check back after then to learn how you can contribute!
    </p>

[% END %]
